{
  "name": "@onda/desktop",
  "version": "3.0.0",
  "productName": "Onda Contacts",
  "main": "build/main.bundle.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "webpack --config webpack.config.ts",
    "watch": "webpack --config webpack.config.ts --mode=development --watch",
    "typecheck": "tsc --noEmit",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@onda/shared": "*",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "dotenv": "^17.2.3",
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12",
    "prisma": "^6.19.3",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "asar": false,
    "appId": "com.onda.onda-contacts",
    "productName": "Onda Contacts",
    "electronVersion": "35.7.5",
    "electronLanguages": [
      "en-US",
      "uk"
    ],
    "publish": null,
    "directories": {
      "buildResources": "../../packages/shared/assets",
      "output": "../../dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../packages/shared/assets/logo256.ico"
    },
    "files": [
      "build/**",
      {
        "from": "../../node_modules/.prisma/client",
        "to": "node_modules/.prisma/client"
      },
      "!**/*.{pdb,zip,tgz,gz,tar,test,spec,d.ts,map,js.map}",
      "!**/*.{md,txt,log}",
      "!.env"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../render/build",
        "to": "render/build"
      },
      {
        "from": "../../packages/shared/assets",
        "to": "assets"
      }
    ],
    "executableName": "onda-contacts",
    "artifactName": "Onda-Contacts-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Onda Contacts",
      "artifactName": "Onda-Contacts-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Onda-Contacts-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "description": "Onda Contacts \u2014 a free, local-first personal CRM.",
  "author": "Oleksandr Hridzhak"
}
